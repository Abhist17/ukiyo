# Copy to .env (git-ignored) and fill in. Never commit the real file.
# A wallet funded with ~0.05 ETH on the chosen testnet: it deploys, then acts as arbitrageur and curator in the bot.
PRIVATE_KEY=0x...
# Unichain Sepolia (1301) or Base Sepolia (84532); both have the canonical v4 PoolManager and priority-fee ordering.
RPC_URL=https://sepolia.unichain.org
# RPC_URL=https://sepolia.base.org
# Optional. On Sepolia keep the threshold low so the bot's arbitrage tips stay cheap: the bot bids 3x the threshold.
# Keep it above the network's suggested tip (eth_maxPriorityFeePerGas, 1e6 wei on Unichain Sepolia), so a wallet's
# default tip still classifies as user flow. The app's Trade tab sets the tip explicitly either way.
THRESHOLD=2000000
EPOCH=600
STEP_MS=15000
# Median user trade in USD; the testnet pool is shallower than the backtest's.
USER_MEDIAN_USD=30000
# Most user swaps per step: at most one per trader wallet, so they all land in the arbitrage's block.
USER_SWAPS_MAX=8
