se}, {"type": "image", "id": "r129", "x": 11220.0, "y": 595, "width": 760, "height": 79.38237965485922, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame131", "roundness": null, "seed": 753480674, "version": 1, "versionNonce": 295391206, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fileId": "f_f_edge", "status": "saved", "scale": [1, 1], "crop": null}, {"type": "text", "id": "r130", "x": 11005.119999999999, "y": 750, "width": 1189.76, "height": 32.5, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame131", "roundness": null, "seed": 542884617, "version": 1, "versionNonce": 980954812, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "the part of an LP's result the manager controls; the market's ups and downs are left out", "originalText": "the part of an LP's result the manager controls; the market's ups and downs are left out", "fontSize": 26, "fontFamily": 5, "textAlign": "center", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"type": "frame", "id": "frame132", "x": 12600, "y": 0, "width": 1600, "height": 900, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 542884617, "version": 1, "versionNonce": 980954812, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "name": "7 · The trap"}, {"type": "text", "id": "n134", "x": 14014.16, "y": 52, "width": 125.84, "height": 27.5, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame132", "roundness": null, "seed": 2058577411, "version": 1, "versionNonce": 318429187, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "2  the idea", "originalText": "2  the idea", "fontSize": 22, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"type": "text", "id": "n135", "x": 12670, "y": 50, "width": 1135.68, "height": 65.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame132", "roundness": null, "seed": 1203533129, "version": 1, "versionNonce": 912252119, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "The trap: the bot's fee gets counted twice", "originalText": "The trap: the bot's fee gets counted twice", "fontSize": 52, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"type": "text", "id": "n136", "x": 12776.0, "y": 150, "width": 1248.0, "height": 37.5, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame132", "roundness": null, "seed": 876082604, "version": 1, "versionNonce": 71188214, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Back to our bot: it took $100 of value and paid a $3 fee. The real result: −$97.", "originalText": "Back to our bot: it took $100 of value and paid a $3 fee. The real result: −$97.", "fontSize": 30, "fontFamily": 5, "textAlign": "center", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"type": "text", "id": "n137", "x": 12810.32, "y": 200, "width": 1179.3600000000001, "height": 35.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame132", "roundness": null, "seed": 297015553, "version": 1, "versionNonce": 1156179110, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "The loss you can see in the pool is $97, because the $3 fee is already inside it.", "originalText": "The loss you can see in the pool is $97, because the $3 fee is already inside it.", "fontSize": 28, "fontFamily": 5, "textAlign": "center", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"type": "rectangle", "id": "n138", "x": 12750, "y": 280, "width": 1300, "height": 175, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame132", "roundness": {"type": 3}, "seed": 1767063625, "version": 1, "versionNonce": 1914290651, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"type": "text", "id": "n139", "x": 12790, "y": 298, "width": 335.92, "height": 42.5, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame132", "roundness": null, "seed": 1069721865, "version": 1, "versionNonce": 259654724, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "The obvious formula", "originalText": "The obvious formula", "fontSize": 34, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"type": "text", "id": "n140", "x