   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Classifier, in beforeSwap\ntip = tx.gasprice − block.basefee\ntip ≥ threshold  →  ARBITRAGE\ntip < threshold  →  USER\nwhen in doubt: arbitrage",
   "originalText": "Classifier, in beforeSwap\ntip = tx.gasprice − block.basefee\ntip ≥ threshold  →  ARBITRAGE\ntip < threshold  →  USER\nwhen in doubt: arbitrage",
   "fontSize": 19,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "re111",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "te113",
   "x": 3710,
   "y": 810,
   "width": 899.08,
   "height": 47.5,
   "angle": 0,
   "strokeColor": "#343a40",
