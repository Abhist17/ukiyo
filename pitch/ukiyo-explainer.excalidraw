   "versionNonce": 1898085555,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A buy and a sell in the same block earn no impact credit: only the block's net move counts.\nLosses round up, credits round down, so rounding can only make Edge read lower.",
   "originalText": "A buy and a sell in the same block earn no impact credit: only the block's net move counts.\nLosses round up, credits round down, so rounding can only make Edge read lower.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
