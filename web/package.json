{
  "name": "ukiyo-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "abi": "node scripts/abi.mjs",
    "bot": "node scripts/bot.mts",
    "bot:testnet": "node --env-file=../.env scripts/bot.mts",
    "test": "node --experimental-strip-types --no-warnings --test \"test/*.test.mts\"",
