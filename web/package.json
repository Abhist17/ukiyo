    "deploy:vercel": "bash scripts/deploy-vercel.sh"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.106.0",
    "next": "16.4.5",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "viem": "2.57.16",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "qr": "0.5.5"
  }
}
